APP_NAME="E-commerce SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8090

# Read-only public demo mode: rejects all mutating requests, reseeds nightly
APP_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecommerce_saas
DB_USERNAME=ecommerce_user
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# IMPORTANT: when running multiple envs under the same parent domain (e.g. flipstack.app
# and develop.flipstack.app), each env MUST set a unique SESSION_COOKIE. Otherwise the
# browser sends the parent-domain cookie to the subdomain, the wrong APP_KEY decrypts
# it, and every request 419s. Production: flipstack_session. Staging: flipstack_staging_session.
SESSION_COOKIE=flipstack_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Mail Configuration
# For production, use resend. For local development, use log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@flipstack.app"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Configuration (for production email)
# Sign up at https://resend.com and get your API key
# MAIL_MAILER=resend
RESEND_KEY=

# SMTP Configuration (alternative to Resend)
# MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# eBay OAuth Integration (App-Level Credentials)
# Get these from: https://developer.ebay.com/my/keys
# Users just click "Connect to eBay" - no credentials needed from them

# Sandbox credentials (used when APP_ENV != production, or EBAY_USE_SANDBOX=true)
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_RU_NAME=

# Production credentials (used when APP_ENV = production, or EBAY_USE_SANDBOX=false)
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_RU_NAME=

# Optional: Override automatic sandbox detection
# EBAY_USE_SANDBOX=true

# App-wide ECN verification token used at /api/webhooks/ebay (no credential id).
# Required for the Marketplace Account Deletion endpoint registered once per
# environment in the eBay Developer Portal. Per-credential webhooks generate
# their own tokens automatically on OAuth callback.
EBAY_APP_NOTIFICATION_TOKEN=
EBAY_SANDBOX_NOTIFICATION_TOKEN=
EBAY_PRODUCTION_NOTIFICATION_TOKEN=

# Shopify OAuth Integration (App-Level Credentials)
# Get these from: https://partners.shopify.com/ (one Partner app per environment)

# Sandbox app (used by develop / Shopify dev stores when APP_ENV != production)
SHOPIFY_SANDBOX_API_KEY=
SHOPIFY_SANDBOX_API_SECRET=

# Production app (used when APP_ENV = production)
SHOPIFY_PRODUCTION_API_KEY=
SHOPIFY_PRODUCTION_API_SECRET=

# Optional: override automatic sandbox detection
# SHOPIFY_USE_SANDBOX=true

# Legacy single-app keys (still read as fallback if env-specific keys are unset)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations,write_fulfillments
SHOPIFY_REDIRECT_URI="${APP_URL}/shopify/auth/callback"

# Amazon SP-API Integration (LWA app — Login With Amazon + Selling Partner API)
# Register one app at https://developer.amazon.com (Apps & Services -> Login With Amazon, then Selling Partner API).
# Same client_id / client_secret used in sandbox + production. Submit SP-API app for review (2-6 wk) before production OAuth.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REDIRECT_URI="${APP_URL}/amazon/auth/callback"
AMAZON_REGION=us-east-1

# Endpoints + marketplace IDs (US default; CA=A2EUQ1WTGCTBG2, MX=A1AM78C64UM0Y8 share NA endpoint)
AMAZON_SANDBOX_ENDPOINT=https://sandbox.sellingpartnerapi-na.amazon.com
AMAZON_SANDBOX_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_PRODUCTION_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Auto-flips to sandbox unless APP_ENV=production. Override with true|false.
# AMAZON_USE_SANDBOX=true

# AWS SNS topic ARN for SP-API notifications (production only).
# Topic must grant Amazon's SP-API service principal sns:Publish.
# HTTPS subscription -> {APP_URL}/api/webhooks/amazon
AMAZON_SNS_ARN=

# Background Removal Service (Flask API)
# Local dev (via Docker network):
BACKGROUND_REMOVAL_URL=http://background-removal:5000
# Production (via Cloudflare Tunnel): https://bg.flipstack.app
BACKGROUND_REMOVAL_API_KEY=
